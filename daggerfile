#!/usr/bin/env -S dagger shell --no-mod

go-version="1.24.4"

# This is a variable, not exposed
build=$(container |\
   from golang:$(go-version)-alpine |\
    with-mounted-file /go/src/go.mod go.mod |\
    with-mounted-file /go/src/go.sum go.sum |\
    with-mounted-cache /root/.cache $(cache-volume go-cache) |\
    with-mounted-cache /go/pkg/mod $(cache-volume go-pkg-mod) |\
    with-exec go mod download |\
    with-mounted-directory /go/src .)

# This is a function, exposed
go-test() {
  $build |\
    with-exec go test -race -coverpkg=./... -coverprofile=.coverage -shuffle=on ./... |\
    stdout
}

go-tidy() {
  tidy=$($build | with-exec go mod tidy -v)
  $tidy | file go.mod | export .
  $tidy | file go.sum | export .
}

go-fmt() {
  $build |\
    with-exec sh -c 'find . -type f -name "*.go" -exec .github/remove_empty_imports.sh "{}" \;' |\
    with-exec goimports -w -local github.com/docker,github.com/eunomie . |\
    with-exec gofumpt -w . |\
    directory /go/src |\
    export .
}
